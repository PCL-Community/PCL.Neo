<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <Color x:Key="NeoControlFillColorDefault">#01e9e9e9</Color>
            <Color x:Key="NeoControlFillColorRed">#80fbdddd</Color>
            <Color x:Key="NeoColorTransparent">#00ffffff</Color>
            <Color x:Key="NeoColorGray1">#404040</Color>
            <Color x:Key="NeoColorGray2">#737373</Color>
            <Color x:Key="NeoColorGray3">#8c8c8c</Color>
            <Color x:Key="NeoColorGray4">#a6a6a6</Color>
            <Color x:Key="NeoColorGray5">#cccccc</Color>
            <Color x:Key="NeoColorGray6">#ebebeb</Color>
            <Color x:Key="NeoColorGray7">#f0f0f0</Color>
            <Color x:Key="NeoColorGray8">#f5f5f5</Color>
            <Color x:Key="NeoColorRedLight">#ff4c4c</Color>
            <Color x:Key="NeoColorRedDark">#ce2111</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="NeoControlFillColorDefault">#01333333</Color>
            <Color x:Key="NeoControlFillColorRed">#80fbdddd</Color>
            <Color x:Key="NeoColorTransparent">#00000000</Color>
            <Color x:Key="NeoColorGray1">#f5f5f5</Color>
            <Color x:Key="NeoColorGray2">#f0f0f0</Color>
            <Color x:Key="NeoColorGray3">#ebebeb</Color>
            <Color x:Key="NeoColorGray4">#cccccc</Color>
            <Color x:Key="NeoColorGray5">#a6a6a6</Color>
            <Color x:Key="NeoColorGray6">#8c8c8c</Color>
            <Color x:Key="NeoColorGray7">#737373</Color>
            <Color x:Key="NeoColorGray8">#404040</Color>
            <Color x:Key="NeoColorRedLight">#ff4c4c</Color>
            <Color x:Key="NeoColorRedDark">#ce2111</Color>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>