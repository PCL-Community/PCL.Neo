<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- [Button] -->
    <Thickness x:Key="NeoButtonPadding">11,5,11,6</Thickness>
    <Thickness x:Key="NeoButtonBorderThickness">1</Thickness>
    <CornerRadius x:Key="NeoButtonCornerRadius">3</CornerRadius>
    
    <SolidColorBrush x:Key="NeoButtonBackgroundBrush" Color="{DynamicResource NeoControlFillColorDefault}" />
    <SolidColorBrush x:Key="NeoButtonForegroundBrush" Color="{DynamicResource NeoSystemAccentColorStroke}" />
    <SolidColorBrush x:Key="NeoButtonBorderBrushBrush" Color="{DynamicResource NeoSystemAccentColorStroke}" />
    <SolidColorBrush x:Key="NeoButtonBackgroundPointerOverBrush" Color="{DynamicResource NeoSystemAccentColorLight5}" />
    <SolidColorBrush x:Key="NeoButtonForegroundPointerOverBrush" Color="{DynamicResource NeoSystemAccentColorLight1}" />
    <SolidColorBrush x:Key="NeoButtonBorderBrushPointerOverBrush" Color="{DynamicResource NeoSystemAccentColorLight1}" />
    <SolidColorBrush x:Key="NeoButtonBackgroundDisabledBrush" Color="{DynamicResource NeoControlFillColorDefault}" />
    <SolidColorBrush x:Key="NeoButtonForegroundDisabledBrush" Color="{DynamicResource NeoColorGray4}" />
    <SolidColorBrush x:Key="NeoButtonBorderBrushDisabledBrush" Color="{DynamicResource NeoColorGray4}" />
    <SolidColorBrush x:Key="NeoButtonAccentBackgroundBrush" Color="{DynamicResource NeoControlFillColorDefault}" />
    <SolidColorBrush x:Key="NeoButtonAccentForegroundBrush" Color="{DynamicResource NeoSystemAccentColor}" />
    <SolidColorBrush x:Key="NeoButtonAccentBorderBrushBrush" Color="{DynamicResource NeoSystemAccentColor}" />
    <SolidColorBrush x:Key="NeoButtonAccentBackgroundPointerOverBrush" Color="{DynamicResource NeoSystemAccentColorLight5}" />
    <SolidColorBrush x:Key="NeoButtonAccentForegroundPointerOverBrush" Color="{DynamicResource NeoSystemAccentColorLight1}" />
    <SolidColorBrush x:Key="NeoButtonAccentBorderBrushPointerOverBrush" Color="{DynamicResource NeoSystemAccentColorLight1}" />
    <SolidColorBrush x:Key="NeoButtonRedBackgroundBrush" Color="{DynamicResource NeoControlFillColorDefault}" />
    <SolidColorBrush x:Key="NeoButtonRedForegroundBrush" Color="{DynamicResource NeoColorRedDark}" />
    <SolidColorBrush x:Key="NeoButtonRedBorderBrushBrush" Color="{DynamicResource NeoColorRedDark}" />
    <SolidColorBrush x:Key="NeoButtonRedBackgroundPointerOverBrush" Color="{DynamicResource NeoControlFillColorRed}" />
    <SolidColorBrush x:Key="NeoButtonRedForegroundPointerOverBrush" Color="{DynamicResource NeoColorRedLight}" />
    <SolidColorBrush x:Key="NeoButtonRedBorderBrushPointerOverBrush" Color="{DynamicResource NeoColorRedLight}" />
    
    <!-- [CheckBox] -->
    <Thickness x:Key="NeoCheckBoxPadding">6,0,0,0</Thickness>
    <Thickness x:Key="NeoCheckBoxBorderThickness">1</Thickness>
    <CornerRadius x:Key="NeoCheckBoxCornerRadius">3</CornerRadius>
    <CornerRadius x:Key="NeoCheckBoxIndeterminateRectangleCornerRadius">2</CornerRadius>
    <x:Double x:Key="NeoCheckBoxMinHeight">20</x:Double>
    <StreamGeometry x:Key="NeoCheckMarkPathData">M0,6L1.5,4.5 4.5,7.5 10.5,1.5 12,3 4.5,10.5 0,6z</StreamGeometry>
    
    <!-- Unchecked -->
    <SolidColorBrush x:Key="NeoCheckBoxBackgroundUncheckedBrush" Color="{DynamicResource NeoColorTransparent}" />
    <SolidColorBrush x:Key="NeoCheckBoxForegroundUncheckedBrush" Color="{DynamicResource NeoSystemAccentColorStroke}" />
    <SolidColorBrush x:Key="NeoCheckBoxBorderBrushUncheckedBrush" Color="{DynamicResource NeoColorTransparent}" />
    <SolidColorBrush x:Key="NeoCheckBoxCheckBackgroundStrokeUncheckedBrush" Color="{DynamicResource NeoSystemAccentColorStroke}" />
    <SolidColorBrush x:Key="NeoCheckBoxCheckBackgroundFillUncheckedBrush" Color="{DynamicResource NeoControlFillColorDefault}" />
    <SolidColorBrush x:Key="NeoCheckBoxCheckGlyphForegroundUncheckedBrush" Color="{DynamicResource NeoControlFillColorDefault}" />
    <SolidColorBrush x:Key="NeoCheckBoxCheckIndeterminateBackgroundUncheckedBrush" Color="{DynamicResource NeoControlFillColorDefault}" />
    <!-- Unchecked PointerOver -->
    <SolidColorBrush x:Key="NeoCheckBoxBackgroundUncheckedPointerOverBrush" Color="{DynamicResource NeoColorTransparent}" />
    <SolidColorBrush x:Key="NeoCheckBoxForegroundUncheckedPointerOverBrush" Color="{DynamicResource NeoSystemAccentColorLight1}" />
    <SolidColorBrush x:Key="NeoCheckBoxBorderBrushUncheckedPointerOverBrush" Color="{DynamicResource NeoColorTransparent}" />
    <SolidColorBrush x:Key="NeoCheckBoxCheckBackgroundStrokeUncheckedPointerOverBrush" Color="{DynamicResource NeoSystemAccentColorLight1}" />
    <SolidColorBrush x:Key="NeoCheckBoxCheckBackgroundFillUncheckedPointerOverBrush" Color="{DynamicResource NeoControlFillColorDefault}" />
    <SolidColorBrush x:Key="NeoCheckBoxCheckGlyphForegroundUncheckedPointerOverBrush" Color="{DynamicResource NeoControlFillColorLight1}" />
    <SolidColorBrush x:Key="NeoCheckBoxCheckIndeterminateBackgroundUncheckedPointerOverBrush" Color="{DynamicResource NeoControlFillColorLight1}" />
    <!-- Unchecked Pressed -->
    <SolidColorBrush x:Key="NeoCheckBoxBackgroundUncheckedPressedBrush" Color="{DynamicResource NeoColorTransparent}" />
    <SolidColorBrush x:Key="NeoCheckBoxForegroundUncheckedPressedBrush" Color="{DynamicResource NeoSystemAccentColorLight1}" />
    <SolidColorBrush x:Key="NeoCheckBoxBorderBrushUncheckedPressedBrush" Color="{DynamicResource NeoColorTransparent}" />
    <SolidColorBrush x:Key="NeoCheckBoxCheckBackgroundStrokeUncheckedPressedBrush" Color="{DynamicResource NeoSystemAccentColorLight1}" />
    <SolidColorBrush x:Key="NeoCheckBoxCheckBackgroundFillUncheckedPressedBrush" Color="{DynamicResource NeoSystemAccentColorPressed}" />
    <SolidColorBrush x:Key="NeoCheckBoxCheckGlyphForegroundUncheckedPressedBrush" Color="{DynamicResource NeoSystemAccentColorLight1}" />
    <SolidColorBrush x:Key="NeoCheckBoxCheckIndeterminateBackgroundUncheckedPressedBrush" Color="{DynamicResource NeoSystemAccentColorLight1}" />
    <!-- Unchecked Disabled -->
    <SolidColorBrush x:Key="NeoCheckBoxBackgroundUncheckedDisabledBrush" Color="{DynamicResource NeoColorTransparent}" />
    <SolidColorBrush x:Key="NeoCheckBoxForegroundUncheckedDisabledBrush" Color="{DynamicResource NeoColorGray4}" />
    <SolidColorBrush x:Key="NeoCheckBoxBorderBrushUncheckedDisabledBrush" Color="{DynamicResource NeoColorTransparent}" />
    <SolidColorBrush x:Key="NeoCheckBoxCheckBackgroundStrokeUncheckedDisabledBrush" Color="{DynamicResource NeoColorGray4}" />
    <SolidColorBrush x:Key="NeoCheckBoxCheckBackgroundFillUncheckedDisabledBrush" Color="{DynamicResource NeoControlFillColorDefault}" />
    <SolidColorBrush x:Key="NeoCheckBoxCheckGlyphForegroundUncheckedDisabledBrush" Color="{DynamicResource NeoColorGray4}" />
    <SolidColorBrush x:Key="NeoCheckBoxCheckIndeterminateBackgroundUncheckedDisabledBrush" Color="{DynamicResource NeoColorGray4}" />
    <!-- Checked -->
    <SolidColorBrush x:Key="NeoCheckBoxBackgroundCheckedBrush" Color="{DynamicResource NeoColorTransparent}" />
    <SolidColorBrush x:Key="NeoCheckBoxForegroundCheckedBrush" Color="{DynamicResource NeoSystemAccentColorStroke}" />
    <SolidColorBrush x:Key="NeoCheckBoxBorderBrushCheckedBrush" Color="{DynamicResource NeoColorTransparent}" />
    <SolidColorBrush x:Key="NeoCheckBoxCheckBackgroundStrokeCheckedBrush" Color="{DynamicResource NeoSystemAccentColor}" />
    <SolidColorBrush x:Key="NeoCheckBoxCheckBackgroundFillCheckedBrush" Color="{DynamicResource NeoControlFillColorDefault}" />
    <SolidColorBrush x:Key="NeoCheckBoxCheckGlyphForegroundCheckedBrush" Color="{DynamicResource NeoSystemAccentColor}" />
    <SolidColorBrush x:Key="NeoCheckBoxCheckIndeterminateBackgroundCheckedBrush" Color="{DynamicResource NeoSystemAccentColor}" />
    <!-- Checked PointerOver -->
    <SolidColorBrush x:Key="NeoCheckBoxBackgroundCheckedPointerOverBrush" Color="{DynamicResource NeoColorTransparent}" />
    <SolidColorBrush x:Key="NeoCheckBoxForegroundCheckedPointerOverBrush" Color="{DynamicResource NeoSystemAccentColorLight1}" />
    <SolidColorBrush x:Key="NeoCheckBoxBorderBrushCheckedPointerOverBrush" Color="{DynamicResource NeoColorTransparent}" />
    <SolidColorBrush x:Key="NeoCheckBoxCheckBackgroundStrokeCheckedPointerOverBrush" Color="{DynamicResource NeoSystemAccentColorLight1}" />
    <SolidColorBrush x:Key="NeoCheckBoxCheckBackgroundFillCheckedPointerOverBrush" Color="{DynamicResource NeoControlFillColorDefault}" />
    <SolidColorBrush x:Key="NeoCheckBoxCheckGlyphForegroundCheckedPointerOverBrush" Color="{DynamicResource NeoSystemAccentColorLight1}" />
    <SolidColorBrush x:Key="NeoCheckBoxCheckIndeterminateBackgroundCheckedPointerOverBrush" Color="{DynamicResource NeoSystemAccentColorLight1}" />
    <!-- Checked Pressed -->
    <SolidColorBrush x:Key="NeoCheckBoxBackgroundCheckedPressedBrush" Color="{DynamicResource NeoColorTransparent}" />
    <SolidColorBrush x:Key="NeoCheckBoxForegroundCheckedPressedBrush" Color="{DynamicResource NeoSystemAccentColorLight1}" />
    <SolidColorBrush x:Key="NeoCheckBoxBorderBrushCheckedPressedBrush" Color="{DynamicResource NeoColorTransparent}" />
    <SolidColorBrush x:Key="NeoCheckBoxCheckBackgroundStrokeCheckedPressedBrush" Color="{DynamicResource NeoSystemAccentColorLight1}" />
    <SolidColorBrush x:Key="NeoCheckBoxCheckBackgroundFillCheckedPressedBrush" Color="{DynamicResource NeoSystemAccentColorPressed}" />
    <SolidColorBrush x:Key="NeoCheckBoxCheckGlyphForegroundCheckedPressedBrush" Color="{DynamicResource NeoSystemAccentColorLight1}" />
    <SolidColorBrush x:Key="NeoCheckBoxCheckIndeterminateBackgroundCheckedPressedBrush" Color="{DynamicResource NeoSystemAccentColorLight1}" />
    <!-- Checked Disabled -->
    <SolidColorBrush x:Key="NeoCheckBoxBackgroundCheckedDisabledBrush" Color="{DynamicResource NeoColorTransparent}" />
    <SolidColorBrush x:Key="NeoCheckBoxForegroundCheckedDisabledBrush" Color="{DynamicResource NeoColorGray4}" />
    <SolidColorBrush x:Key="NeoCheckBoxBorderBrushCheckedDisabledBrush" Color="{DynamicResource NeoColorTransparent}" />
    <SolidColorBrush x:Key="NeoCheckBoxCheckBackgroundStrokeCheckedDisabledBrush" Color="{DynamicResource NeoColorGray4}" />
    <SolidColorBrush x:Key="NeoCheckBoxCheckBackgroundFillCheckedDisabledBrush" Color="{DynamicResource NeoControlFillColorDefault}" />
    <SolidColorBrush x:Key="NeoCheckBoxCheckGlyphForegroundCheckedDisabledBrush" Color="{DynamicResource NeoColorGray4}" />
    <SolidColorBrush x:Key="NeoCheckBoxCheckIndeterminateBackgroundCheckedDisabledBrush" Color="{DynamicResource NeoColorGray4}" />
    <!-- Indeterminate -->
    <SolidColorBrush x:Key="NeoCheckBoxBackgroundIndeterminateBrush" Color="{DynamicResource NeoColorTransparent}" />
    <SolidColorBrush x:Key="NeoCheckBoxForegroundIndeterminateBrush" Color="{DynamicResource NeoSystemAccentColorStroke}" />
    <SolidColorBrush x:Key="NeoCheckBoxBorderBrushIndeterminateBrush" Color="{DynamicResource NeoColorTransparent}" />
    <SolidColorBrush x:Key="NeoCheckBoxCheckBackgroundStrokeIndeterminateBrush" Color="{DynamicResource NeoSystemAccentColor}" />
    <SolidColorBrush x:Key="NeoCheckBoxCheckBackgroundFillIndeterminateBrush" Color="{DynamicResource NeoControlFillColorDefault}" />
    <SolidColorBrush x:Key="NeoCheckBoxCheckGlyphForegroundIndeterminateBrush" Color="{DynamicResource NeoSystemAccentColor}" />
    <SolidColorBrush x:Key="NeoCheckBoxCheckIndeterminateBackgroundIndeterminateBrush" Color="{DynamicResource NeoSystemAccentColor}" />
    <!-- Indeterminate PointerOver -->
    <SolidColorBrush x:Key="NeoCheckBoxBackgroundIndeterminatePointerOverBrush" Color="{DynamicResource NeoColorTransparent}" />
    <SolidColorBrush x:Key="NeoCheckBoxForegroundIndeterminatePointerOverBrush" Color="{DynamicResource NeoSystemAccentColorLight1}" />
    <SolidColorBrush x:Key="NeoCheckBoxBorderBrushIndeterminatePointerOverBrush" Color="{DynamicResource NeoColorTransparent}" />
    <SolidColorBrush x:Key="NeoCheckBoxCheckBackgroundStrokeIndeterminatePointerOverBrush" Color="{DynamicResource NeoSystemAccentColorLight1}" />
    <SolidColorBrush x:Key="NeoCheckBoxCheckBackgroundFillIndeterminatePointerOverBrush" Color="{DynamicResource NeoControlFillColorDefault}" />
    <SolidColorBrush x:Key="NeoCheckBoxCheckGlyphForegroundIndeterminatePointerOverBrush" Color="{DynamicResource NeoSystemAccentColorLight1}" />
    <SolidColorBrush x:Key="NeoCheckBoxCheckIndeterminateBackgroundIndeterminatePointerOverBrush" Color="{DynamicResource NeoSystemAccentColorLight1}" />
    <!-- Indeterminate Pressed -->
    <SolidColorBrush x:Key="NeoCheckBoxBackgroundIndeterminatePressedBrush" Color="{DynamicResource NeoColorTransparent}" />
    <SolidColorBrush x:Key="NeoCheckBoxForegroundIndeterminatePressedBrush" Color="{DynamicResource NeoSystemAccentColorLight1}" />
    <SolidColorBrush x:Key="NeoCheckBoxBorderBrushIndeterminatePressedBrush" Color="{DynamicResource NeoColorTransparent}" />
    <SolidColorBrush x:Key="NeoCheckBoxCheckBackgroundStrokeIndeterminatePressedBrush" Color="{DynamicResource NeoSystemAccentColorLight1}" />
    <SolidColorBrush x:Key="NeoCheckBoxCheckBackgroundFillIndeterminatePressedBrush" Color="{DynamicResource NeoSystemAccentColorPressed}" />
    <SolidColorBrush x:Key="NeoCheckBoxCheckGlyphForegroundIndeterminatePressedBrush" Color="{DynamicResource NeoSystemAccentColorLight1}" />
    <SolidColorBrush x:Key="NeoCheckBoxCheckIndeterminateBackgroundIndeterminatePressedBrush" Color="{DynamicResource NeoSystemAccentColorLight1}" />
    <!-- Indeterminate Disabled -->
    <SolidColorBrush x:Key="NeoCheckBoxBackgroundIndeterminateDisabledBrush" Color="{DynamicResource NeoColorTransparent}" />
    <SolidColorBrush x:Key="NeoCheckBoxForegroundIndeterminateDisabledBrush" Color="{DynamicResource NeoColorGray4}" />
    <SolidColorBrush x:Key="NeoCheckBoxBorderBrushIndeterminateDisabledBrush" Color="{DynamicResource NeoColorTransparent}" />
    <SolidColorBrush x:Key="NeoCheckBoxCheckBackgroundStrokeIndeterminateDisabledBrush" Color="{DynamicResource NeoColorGray4}" />
    <SolidColorBrush x:Key="NeoCheckBoxCheckBackgroundFillIndeterminateDisabledBrush" Color="{DynamicResource NeoControlFillColorDefault}" />
    <SolidColorBrush x:Key="NeoCheckBoxCheckGlyphForegroundIndeterminateDisabledBrush" Color="{DynamicResource NeoColorGray4}" />
    <SolidColorBrush x:Key="NeoCheckBoxCheckIndeterminateBackgroundIndeterminateDisabledBrush" Color="{DynamicResource NeoColorGray4}" />
    
    <!-- [ScrollBar] -->
    <x:Double x:Key="NeoScrollBarSize">16</x:Double>
    <CornerRadius x:Key="NeoScrollBarCornerRadius">8</CornerRadius>
    
    <SolidColorBrush x:Key="NeoScrollBarBackgroundBrush" Color="{DynamicResource NeoColorTransparent}" />
    <SolidColorBrush x:Key="NeoScrollBarForegroundBrush" Color="{DynamicResource NeoSystemAccentColorLight1}" />
    <SolidColorBrush x:Key="NeoScrollBarBorderBrushBrush" Color="{DynamicResource NeoColorTransparent}" />
    <SolidColorBrush x:Key="NeoScrollBarThumbBackgroundBrush" Color="{DynamicResource NeoSystemAccentColorLight2}" />
    <SolidColorBrush x:Key="NeoScrollBarThumbBackgroundPointerOverBrush" Color="{DynamicResource NeoSystemAccentColorLight1}" />
    <SolidColorBrush x:Key="NeoScrollBarThumbBackgroundPressedBrush" Color="{DynamicResource NeoSystemAccentColorLight1}" />
    <SolidColorBrush x:Key="NeoScrollBarThumbBackgroundDisabledBrush" Color="{DynamicResource NeoColorGray4}" />
    
    <!-- [NeoLoading] -->
    <StreamGeometry x:Key="NeoLoadingPickaxePathData">M 963.6 858.2 410.816 305.504 C 508.116 213.304 609.204 196.8 711.104 128.6 837.11367 49.573762 879.34045 50.334062 751.5 49.5 611.3 52 471.8 96.2 353.3 182.4 309.8 155.7 252.1 161.2 214.5 198.9 176.9 236.6 171.3 294.2 198 337.7 111.8 456.3 67.6 595.8 65.1 735.9 63.315254 883.82034 65.077966 837.29308 144.2 695.488 212.4 593.588 228.888 492.4 321.088 395.2 L 873.9 948 c 0.60001 0.59999 1.6 0.6 2.2 0 l 87.5 -87.5 c 0.6 -0.7 0.6 -1.6 0 -2.3 z</StreamGeometry>
    <StreamGeometry x:Key="NeoLoadingPiecePathData">M0,0L2,0L1,4</StreamGeometry>
    <StreamGeometry x:Key="NeoLoadingIconFailedPathData">F1 M2,0 L0,2 8,10 0,18 2,20 10,12 18,20 20,18 12,10 20,2 18,0 10,8 2,0Z</StreamGeometry>
    <StreamGeometry x:Key="NeoLoadingIconSuccessPathData">M0,6L1.5,4.5 4.5,7.5 10.5,1.5 12,3 4.5,10.5 0,6z</StreamGeometry>

    <SolidColorBrush x:Key="NeoLoadingForegroundBrush" Color="{DynamicResource NeoSystemAccentColorStroke}" />
    <SolidColorBrush x:Key="NeoLoadingForegroundLoadingBrush" Color="{DynamicResource NeoSystemAccentColor}" />
    <SolidColorBrush x:Key="NeoLoadingForegroundFailedBrush" Color="{DynamicResource NeoColorRedLight}" />
    <SolidColorBrush x:Key="NeoLoadingForegroundSuccessBrush" Color="{DynamicResource NeoColorGreenLight}" />
</ResourceDictionary>
